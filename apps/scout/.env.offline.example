# Scout - offline (LAN) build settings
#
# Copy to apps/scout/.env.offline, then build with offline mode:
#   pnpm --filter scout exec vite build --mode offline
# Vite loads .env first and .env.offline on top, so anything set in your dev
# .env that should NOT apply offline must be overridden (blanked) here.
# These values are baked into the build; rebuild after changing them.

# Adds "XIMI Offline" (https://server.ximi.offline) to the server picker,
# as the default option
VITE_HAS_OFFLINE=true

# Keep empty offline. If set, it adds a second entry above "XIMI Offline".
VITE_XIMI_SERVER_URL=

# Dev server port only; `start:offline` serves the build on 3300 regardless
VITE_PORT=3300
