# XIMI offline: HTTPS for every *.ximi.offline hostname.
#
# Run from apps/server (certificate paths are relative to it):
#   pnpm --filter server caddy:offline        (or `pnpm offline` from the repo root)
# Certificates: see certs/README.md

{
	# certificates are provided below; never try to obtain or install any
	auto_https disable_certs
	skip_install_trust
}

(ximi_tls) {
	tls ../../certs/ximi.offline.crt ../../certs/ximi.offline.key
}

livekit.ximi.offline {
	import ximi_tls
	reverse_proxy 127.0.0.1:7880
}

control.ximi.offline {
	import ximi_tls
	reverse_proxy 127.0.0.1:3100
}

performer.ximi.offline {
	import ximi_tls
	reverse_proxy 127.0.0.1:3200
}

scout.ximi.offline {
	import ximi_tls
	reverse_proxy 127.0.0.1:3300
}

output.ximi.offline {
	import ximi_tls
	reverse_proxy 127.0.0.1:3400
}

server.ximi.offline {
	import ximi_tls
	reverse_proxy 127.0.0.1:4000
}
