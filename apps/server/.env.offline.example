# XIMI server - offline (LAN) settings
#
# Copy to apps/server/.env.offline on the host machine and fill in.
# `pnpm --filter server start:offline` loads that file (not .env), and trusts
# the XIMI CA in certs/ximi-ca.crt for its HTTPS calls to LiveKit.

# LiveKit as browsers reach it, through Caddy. The server calls LiveKit at the
# same address, so the host must resolve *.ximi.offline itself
# (/etc/resolver/ximi.offline or /etc/hosts).
LIVEKIT_HOST=https://livekit.ximi.offline

# Must match the `keys:` entry in the LiveKit config the host runs
# (apps/server/setup/livekit.yaml):  keys: { <LIVEKIT_KEY>: <LIVEKIT_SECRET> }
# Generate a pair with:  livekit-server generate-keys
LIVEKIT_KEY=
LIVEKIT_SECRET=

# Port this server listens on. Caddy proxies https://server.ximi.offline here.
port=4000

# Where room state is saved. Default: apps/server/data
# DATA_DIR=
