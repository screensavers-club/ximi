# Output - offline (LAN) build settings
#
# Copy to apps/output/.env.offline, then build with offline mode:
#   pnpm --filter output exec vite build --mode offline
#
# Output needs no server or LiveKit settings: its link (copied from Control)
# carries the server address in ?server=..., and the server tells it where
# LiveKit is. Links look like:
#   https://output.ximi.offline/?room=...&target=...&passcode=...&mode=2&server=https%3A%2F%2Fserver.ximi.offline

# Dev server port only; `start:offline` serves the build on 3400 regardless
VITE_PORT=3400
